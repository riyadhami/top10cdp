# Azure OpenAI (optional: without these the app uses rule-based mapping and narrative)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment used for the executive narrative (e.g. a gpt-4o / gpt-4.1 deployment)
AZURE_OPENAI_DEPLOYMENT=
# Cheaper deployment used for column mapping (falls back to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_DEPLOYMENT_MINI=

# Salt for hashing customer identifiers. Change it per environment and keep it secret.
APP_SALT=change-me
# Where workspaces (uploads, runs, history) are stored
DATA_DIR=data/workspaces
# Days to keep uploaded data before it is purged
RETENTION_DAYS=90

# Optional API key for the FastAPI service (sent as X-API-Key). Leave empty to disable.
API_KEY=
